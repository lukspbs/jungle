# Variáveis da suíte de testes de integração.
#
#   set -a && source .env.test && set +a
#   go test -race ./...
#
# Os endereços são os expostos pelo Compose no host. As filas são dedicadas:
# sem isso a suíte disputaria mensagens com o consumidor da aplicação.
export TEST_DATABASE_URL="postgres://jungle:jungle@127.0.0.1:5432/jungle?sslmode=disable"
export TEST_AUTH_ISSUER_URL="http://localhost:8081/realms/jungle"
export TEST_SQS_ENDPOINT="http://localhost:4566"
export TEST_SQS_INBOUND_QUEUE_URL="http://localhost:4566/000000000000/test-wager-transactions.fifo"
export TEST_SQS_OUTBOUND_QUEUE_URL="http://localhost:4566/000000000000/test-wager-events"
export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_REGION=us-east-1
