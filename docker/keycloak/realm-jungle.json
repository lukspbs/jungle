{
  "realm": "jungle",
  "enabled": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "wallet-admin",
        "description": "Opera carteiras: abertura, consulta e reconciliação. Reservado ao serviço interno."
      },
      {
        "name": "wager-provider",
        "description": "Envia e consulta operações do próprio provedor."
      }
    ]
  },
  "clients": [
    {
      "clientId": "jungle-internal",
      "name": "Serviço interno",
      "description": "Abre carteiras e roda reconciliação. Não envia operações de provedor.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "internal-secret-local",
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-a",
      "name": "Provedor A",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "provider-a-secret-local",
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-a",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-b",
      "name": "Provedor B",
      "description": "Existe para provar o isolamento: não enxerga as operações do provider-a.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "provider-b-secret-local",
      "attributes": {
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-b",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "provider-efemero",
      "name": "Provedor efêmero",
      "description": "Existe para provar a recusa de token expirado: o lifespan de 1s faz o token morrer antes de o teste usá-lo.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "provider-efemero-secret-local",
      "attributes": {
        "access.token.lifespan": "1"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "jungle-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "provider-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "provider_id",
            "claim.value": "provider-efemero",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "jungle-api",
      "name": "API de apostas",
      "description": "Audiência dos tokens. Não emite token próprio.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "service-account-jungle-internal",
      "enabled": true,
      "serviceAccountClientId": "jungle-internal",
      "realmRoles": [
        "wallet-admin"
      ]
    },
    {
      "username": "service-account-provider-a",
      "enabled": true,
      "serviceAccountClientId": "provider-a",
      "realmRoles": [
        "wager-provider"
      ]
    },
    {
      "username": "service-account-provider-b",
      "enabled": true,
      "serviceAccountClientId": "provider-b",
      "realmRoles": [
        "wager-provider"
      ]
    },
    {
      "username": "service-account-provider-efemero",
      "enabled": true,
      "serviceAccountClientId": "provider-efemero",
      "realmRoles": [
        "wager-provider"
      ]
    }
  ]
}