# Configuração local de exemplo. Nenhum valor aqui é segredo de produção:
# são credenciais de emulador, todas descartáveis.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=20s

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=jungle
POSTGRES_PASSWORD=jungle
POSTGRES_DB=jungle
DATABASE_URL=postgres://jungle:jungle@postgres:5432/jungle?sslmode=disable

DATABASE_MAX_CONNS=10
DATABASE_MIN_CONNS=2
# Limita a duração de um comando no servidor. Sem isso, um cliente travado
# seguraria o lock de uma carteira indefinidamente.
DATABASE_STATEMENT_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Autenticação
# ---------------------------------------------------------------------------
# O emissor é a URL pela qual os clientes alcançam o Keycloak, e é o que os
# tokens declaram no claim iss.
AUTH_ISSUER_URL=http://localhost:8081/realms/jungle
# As chaves são buscadas pela rede interna do Compose. Seguir o jwks_uri do
# documento de descoberta não funcionaria: ele repete localhost:8081, que dentro
# do container da aplicação é a própria aplicação.
AUTH_JWKS_URL=http://keycloak:8080/realms/jungle/protocol/openid-connect/certs
AUTH_AUDIENCE=jungle-api

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Mensageria
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localstack:4566
SQS_INBOUND_QUEUE_URL=http://localstack:4566/000000000000/wager-transactions.fifo
SQS_OUTBOUND_QUEUE_URL=http://localstack:4566/000000000000/wager-events

SQS_MAX_MESSAGES=10
SQS_WAIT_TIME=20s
SQS_VISIBILITY_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Outbox
# ---------------------------------------------------------------------------
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_POLL_INTERVAL=1s
OUTBOX_INITIAL_BACKOFF=1s
OUTBOX_MAX_BACKOFF=1m

# ---------------------------------------------------------------------------
# Referências pendentes
# ---------------------------------------------------------------------------
# Esgotado o prazo ou as tentativas, a reversão é recusada com
# REFERENCE_NOT_FOUND em vez de ficar pendente para sempre.
REFERENCE_TTL=15m
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_INITIAL_BACKOFF=2s
REFERENCE_MAX_BACKOFF=2m
REFERENCE_POLL_INTERVAL=2s
REFERENCE_BATCH_SIZE=50
